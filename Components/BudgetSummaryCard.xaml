<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:trackr.ViewModels"
    xmlns:local="clr-namespace:trackr"
    x:Class="trackr.Components.BudgetSummaryCard"
    x:DataType="viewModels:BudgetPageViewModel">

    <ContentView.Resources>

        <local:AmountToColorConverter x:Key="AmountToColorConverter"/>

    </ContentView.Resources>

    <!-- Net Worth Card -->
    <Border>

        <VerticalStackLayout
            Spacing="10">

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10">

                <VerticalStackLayout
                    Grid.Column="0">

                    <Label
                        Style="{StaticResource SectionHeader}"
                        Text="SPENT"/>

                    <Label
                        Style="{StaticResource NetWorthValue}"
                        Text="{Binding TotalAmountSpent, StringFormat='{}{0:$#,##0.00;-$#,##0.00}'}"
                        FontSize="30"/>

                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Column="1">

                    <Label
                        Style="{StaticResource SectionHeader}"
                        Text="MONTHLY BUDGET"
                        HorizontalTextAlignment="End"/>

                    <Label
                        Style="{StaticResource NetWorthValue}"
                        Text="{Binding MonthlyBudget, StringFormat='{}{0:$#,##0.00;-$#,##0.00}'}"
                        FontSize="30"
                        HorizontalTextAlignment="End"/>

                </VerticalStackLayout>

            </Grid>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10">

                <Label
                    Grid.Column="0"
                    Style="{StaticResource SectionHeader}"
                    Text="{Binding BudgetPercentageUsed, StringFormat='{}{0:0%} used'}"/>

                <Label
                    Grid.Column="1"
                    Style="{StaticResource SectionHeader}"
                    Text="{Binding RemainingBudget, StringFormat='{}{0:$#,##0.00;-$#,##0.00} remaining'}"
                    HorizontalTextAlignment="End"/>

            </Grid>

        </VerticalStackLayout>

    </Border>

</ContentView>